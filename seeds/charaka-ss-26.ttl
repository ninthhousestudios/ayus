# ══════════════════════════════════════════════════
# Vipaka Rules
# ══════════════════════════════════════════════════

ayurveda:vipaka_rule_katu  a ayurveda:VipakaRule ;
    rdfs:label          "katu vipaka rule" ;
    ayurveda:inputRasa   ayurveda:katu, ayurveda:tikta, ayurveda:kashaya ;
    ayurveda:resultVipaka ayurveda:katu .

ayurveda:vipaka_rule_amla  a ayurveda:VipakaRule ;
    rdfs:label          "amla vipaka rule" ;
    ayurveda:inputRasa   ayurveda:amla ;
    ayurveda:resultVipaka ayurveda:amla .

ayurveda:vipaka_rule_madhura  a ayurveda:VipakaRule ;
    rdfs:label          "madhura vipaka rule" ;
    ayurveda:inputRasa   ayurveda:madhura, ayurveda:lavana ;
    ayurveda:resultVipaka ayurveda:madhura .

ayurveda:katu  ayurveda:vipakaEffect  "destructive of semen; leads to retention of faeces and urine, and to increase of wind" .
ayurveda:madhura  ayurveda:vipakaEffect  "easy and copious discharges of urine and stools; increases phlegm and semen; produces heaviness" .
ayurveda:amla  ayurveda:vipakaEffect  "increase of bile; evacuation of stools and urine; destruction of semen" .

# ══════════════════════════════════════════════════
# Veerya Classification
# ══════════════════════════════════════════════════

ayurveda:veerya_twofold  rdfs:label "two-fold veerya" ;
    rdf:value  ayurveda:sheeta, ayurveda:ushna .

ayurveda:veerya_eightfold  rdfs:label "eight-fold veerya" ;
    rdf:value  ayurveda:manda, ayurveda:tikshna, ayurveda:guru, ayurveda:laghu, ayurveda:snigdha, ayurveda:ruksha, ayurveda:ushna, ayurveda:sheeta .

# ══════════════════════════════════════════════════
# Hierarchy: prabhava > veerya > vipaka > rasa
# ══════════════════════════════════════════════════

ayurveda:prabhava  ayurveda:hierarchyRank  "1"^^xsd:integer .
ayurveda:veerya  ayurveda:hierarchyRank  "2"^^xsd:integer .
ayurveda:vipaka  ayurveda:hierarchyRank  "3"^^xsd:integer .
ayurveda:rasa  ayurveda:hierarchyRank  "4"^^xsd:integer .

# ══════════════════════════════════════════════════
# Prabhava (specific potency) — definition and example
# ══════════════════════════════════════════════════

ayurveda:prabhava_example  rdfs:label "prabhava example" ;
    rdfs:comment "Chitraka (Plumbago Zeylanica) and Danti (Baliospermum montanum) — both pungent in taste, pungent in assimilation, hot in energy. Danti is purgative, Chitraka is not The difference is due to prabhava (potency) of Danti" ;
    rdf:value    "The difference is due to prabhava (potency) of Danti" .

# ══════════════════════════════════════════════════
# Viruddha Ahara (Incompatible Food Combinations)
# ══════════════════════════════════════════════════

ayurveda:viruddha_fish_with_milk  a ayurveda:ViruddhaRule ;
    rdfs:label          "fish with milk" ;
    ayurveda:combination "fish with milk" ;
    ayurveda:effect      "corrupts blood; stops pores and passages; causes heaviness of body" .

ayurveda:viruddha_chilichima_fish_with_milk  a ayurveda:ViruddhaRule ;
    rdfs:label          "Chilichima fish with milk" ;
    ayurveda:combination "Chilichima fish with milk" ;
    ayurveda:effect      "diseases of blood or suppression of impurities; possibly death" .

ayurveda:viruddha_meat_of_domesticated_marshy_or_aquatic_animals_with_honey_sesame_oil_molasses_milk_masha_mulaka_lotus_stalks_or_sprouted_paddy  a ayurveda:ViruddhaRule ;
    rdfs:label          "meat of domesticated, marshy, or aquatic animals with honey, sesame oil, molasses, milk, Masha, Mulaka, lotus stalks, or sprouted paddy" ;
    ayurveda:combination "meat of domesticated, marshy, or aquatic animals with honey, sesame oil, molasses, milk, Masha, Mulaka, lotus stalks, or sprouted paddy" ;
    ayurveda:effect      "deafness, blindness, paralysis agitans, rigidity, lassitude, dumbness, nasal voice, or death" .

ayurveda:viruddha_paushkara_lotus_leaves_and_rohinika_picrorhiza_kurroa_potherbs_or_pigeons_fried_in_oil_with_honey_and_milk  a ayurveda:ViruddhaRule ;
    rdfs:label          "Paushkara (lotus leaves) and Rohinika (Picrorhiza Kurroa) potherbs, or pigeons fried in oil, with honey and milk" ;
    ayurveda:combination "Paushkara (lotus leaves) and Rohinika (Picrorhiza Kurroa) potherbs, or pigeons fried in oil, with honey and milk" ;
    ayurveda:effect      "corruption of blood, exhaustion of nerves, delusions, pain and heat with puffiness in temples and forehead, bronchocele, red eruptions (Rohinika), or death" .

ayurveda:viruddha_mulaka_radish_laguna_garlic_krishnagandha_moringa_pterygosperma_arjjaka_sumukha_or_surasa_varieties_of_ocimum_with_milk  a ayurveda:ViruddhaRule ;
    rdfs:label          "Mulaka (radish), Laguna (garlic), Krishnagandha (Moringa pterygosperma), Arjjaka, Sumukha, or Surasa (varieties of Ocimum) with milk" ;
    ayurveda:combination "Mulaka (radish), Laguna (garlic), Krishnagandha (Moringa pterygosperma), Arjjaka, Sumukha, or Surasa (varieties of Ocimum) with milk" ;
    ayurveda:effect      "leprosy" .

ayurveda:viruddha_bamboo_leaves_and_ripe_lakuchas_artocarpus_lakoocha_with_honey_and_milk  a ayurveda:ViruddhaRule ;
    rdfs:label          "bamboo leaves and ripe Lakuchas (Artocarpus Lakoocha) with honey and milk" ;
    ayurveda:combination "bamboo leaves and ripe Lakuchas (Artocarpus Lakoocha) with honey and milk" ;
    ayurveda:effect      "death, or loss of strength, complexion, energy, vital seed; various violent diseases; impotence" .

ayurveda:viruddha_ripe_lakuchas_with_broth_of_phaseolus_radiatus_or_molasses_or_ghee  a ayurveda:ViruddhaRule ;
    rdfs:label          "ripe Lakuchas with broth of Phaseolus radiatus, or molasses, or ghee" ;
    ayurveda:combination "ripe Lakuchas with broth of Phaseolus radiatus, or molasses, or ghee" ;
    ayurveda:effect      "hostile in properties (unspecified)" .

ayurveda:viruddha_sour_fruits_amrataka_matulunga_lakucha_karamardda_mocha_dantasatha_vadara_kalamra_bhavya_jamvava_kapittha_tintidika_paravata_akshota_panasa_narikela_dadima_amlaka_with_milk  a ayurveda:ViruddhaRule ;
    rdfs:label          "sour fruits (Amrataka, Matulunga, Lakucha, Karamardda, Mocha, Dantasatha, Vadara, Kalamra, Bhavya, Jamvava, Kapittha, Tintidika, Paravata, Akshota, Panasa, Narikela, Dadima, Amlaka) with milk" ;
    ayurveda:combination "sour fruits (Amrataka, Matulunga, Lakucha, Karamardda, Mocha, Dantasatha, Vadara, Kalamra, Bhavya, Jamvava, Kapittha, Tintidika, Paravata, Akshota, Panasa, Narikela, Dadima, Amlaka) with milk" ;
    ayurveda:effect      "hostile (unspecified)" .

ayurveda:viruddha_kangu_setaria_italica_varaka_mukushthaka_phaseolus_aconitifolius_kulattha_dolichos_uniflorus_masha_phaseolus_radiatus_or_nishpava_vigna_catjang_with_milk  a ayurveda:ViruddhaRule ;
    rdfs:label          "Kangu (Setaria Italica), Varaka, Mukushthaka (Phaseolus aconitifolius), Kulattha (Dolichos uniflorus), Masha (Phaseolus radiatus), or Nishpava (Vigna catjang) with milk" ;
    ayurveda:combination "Kangu (Setaria Italica), Varaka, Mukushthaka (Phaseolus aconitifolius), Kulattha (Dolichos uniflorus), Masha (Phaseolus radiatus), or Nishpava (Vigna catjang) with milk" ;
    ayurveda:effect      "hostile (unspecified)" .

ayurveda:viruddha_padmottarika_carthamus_tinctorius_with_sugar_maireya_wine_and_honey  a ayurveda:ViruddhaRule ;
    rdfs:label          "Padmottarika (Carthamus tinctorius) with Sugar-Maireya (wine) and honey" ;
    ayurveda:combination "Padmottarika (Carthamus tinctorius) with Sugar-Maireya (wine) and honey" ;
    ayurveda:effect      "excites/provokes the wind exceedingly" .

ayurveda:viruddha_mantha_barley_gruel_with_ghee_and_water_after_payasa_rice_boiled_in_sugar_and_milk  a ayurveda:ViruddhaRule ;
    rdfs:label          "Mantha (barley gruel with ghee and water) after Payasa (rice boiled in sugar and milk)" ;
    ayurveda:combination "Mantha (barley gruel with ghee and water) after Payasa (rice boiled in sugar and milk)" ;
